<?xml version="1.0" encoding="utf-8"?>
<!--
  NuGet package source layout for Unity.Multiplayer.

  Two sources, intentionally ordered:

    1. lib/local-packages/  (relative to this file)
       Holds the MindAttic.* private packages this repo depends on (Vault, for
       Hosting.Cli's credential storage). Checked into git so CI can restore
       without seeing the developer's C:\LocalNuGet. Keep it small, only the
       versions actually referenced by the csproj files. Regenerate by copying
       the matching .nupkg from the producer repo's `dotnet pack` output.

    2. nuget.org
       Everything else. Standard public feed.

  When you bump MindAttic.Vault, drop the new .nupkg in lib/local-packages/ AND
  update the PackageReference version in src/Hosting.Cli/Hosting.Cli.csproj.
  Old .nupkg files can stay in the folder; NuGet picks the version requested
  by the csproj.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="local-packages" value="./lib/local-packages" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
